# 本机真实配置与凭据（模板见 config.example.json）
/config.json
/config.json.bak*
/data/
*.key

# 运行日志与临时导出
/logs/
/.tmp-*.json

# 便携版 PostgreSQL（约 200MB，可整目录删除）
/.tools/

# 构建产物
/*.exe
/*.exe.*
/*.exe~
/*.exe.bak-*

# 工作台草稿、内部流程与调研资料（保留在本地，不随源码发布）
#
# !! 重要：以下路径 git 从不记账，磁盘上是唯一副本 —— 删了就没了 !!
# 2026-11-09 事故：迁移前清理磁盘时 .scratch/ 被当成可删的临时目录清掉，
# 丢了 BP-01..BP-294 全部票面（.scratch/bargainproxy/issues/，199 个文件），
# 而 workflow-state.md 的审批绑定正指向这些文件。已从旧机恢复。
# 清空间或换机之前，先跑：scripts\backup-local.cmd
/.scratch/
/research/
/specs/
/workflow-state.md
/execution-report.md
/review-report.md
/user-acceptance.md
/execution-handoff.md

# 安全钩子运行态
.mimosa/

# ZCode 插件同步状态（属于本机 ZCode 配置）
/plugins/bargainproxy-opencode/bargainproxy-opencode.state.json

# 编辑器/系统生成的备份副本
/*.exe~
/*.exe.bak*

# Other sessions' ad-hoc launch probes
/.scratch_*.log
/.scratch_*.ps1
/.e2e.*
/bargainproxy.exe.new-*
